rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // =====================================================
    // ADMIN
    // =====================================================

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "2GsnovCgxlYVz46LYSM2iRicMQk1";
    }";
    }

    // =====================================================
    // VALIDATION HELPERS
    // =====================================================

    function isValidImage() {
      return request.resource != null
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp|gif)'
        );
    }

    function isValidPdf() {
      return request.resource != null
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // =====================================================
    // EDUCATION IMAGES
    // =====================================================

    match /portfolio/education/images/{itemId}/{fileName} {

      // Images used by the public portfolio
      allow read: if true;

      // Only Admin can upload or replace
      allow create, update:
        if isAdmin()
        && isValidImage();

      // Only Admin can delete
      allow delete:
        if isAdmin();
    }

    // =====================================================
    // PROJECT IMAGES
    // =====================================================

    match /portfolio/projects/images/{itemId}/{fileName} {

      allow read: if true;

      allow create, update:
        if isAdmin()
        && isValidImage();

      allow delete:
        if isAdmin();
    }

    // =====================================================
    // RESUME PDF
    // =====================================================

    match /portfolio/resume/documents/{itemId}/{fileName} {

      allow read: if true;

      allow create, update:
        if isAdmin()
        && isValidPdf();

      allow delete:
        if isAdmin();
    }

    // =====================================================
    // BLOCK EVERYTHING ELSE
    // =====================================================

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}