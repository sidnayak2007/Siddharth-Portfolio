rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == '2GsnovCgxlYVz46LYSM2iRicMQk1';
    }

    function validPath(itemId, fileName) {
      return itemId.size() > 0 && itemId.size() <= 120
        && fileName.size() > 0 && fileName.size() <= 160;
    }

    function validImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function validPdf() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    match /portfolio/{sectionId}/images/{itemId}/{fileName} {
      allow read: if sectionId in ['about', 'experience', 'projects', 'education'];
      allow create: if isAdmin()
        && sectionId in ['about', 'experience', 'projects', 'education']
        && validPath(itemId, fileName)
        && validImage();
      allow update: if false;
      allow delete: if isAdmin()
        && sectionId in ['about', 'experience', 'projects', 'education'];
    }

    match /portfolio/{sectionId}/documents/{itemId}/{fileName} {
      allow read: if sectionId in ['experience', 'education', 'resume'];
      allow create: if isAdmin()
        && sectionId in ['experience', 'education', 'resume']
        && validPath(itemId, fileName)
        && validPdf();
      allow update: if false;
      allow delete: if isAdmin()
        && sectionId in ['experience', 'education', 'resume'];
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
